---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import config from "@/config";
import { topics as readingPaths, topicsPage } from "@/data/notebook";
import { getSortedPosts } from "@/utils/getSortedPosts";

const posts = getSortedPosts(await getCollection("posts"));
const topics = readingPaths.map(topic => ({
  ...topic,
  entries: topic.posts.map(slug => {
    const post = posts.find(post => post.id === slug);
    if (!post) throw new Error(`Reading-path article not found: ${slug}`);
    return post;
  }),
}));
---

<Layout
  title={`${topicsPage.title} | ${config.site.title}`}
  description={topicsPage.description}
>
  <Header />
  <main id="main-content" class="app-layout my-8">
    <h1 class="text-accent text-3xl font-bold">{topicsPage.title}</h1>
    <p class="mt-4">{topicsPage.body}</p>
    <nav
      aria-label="Reading paths"
      class="text-accent my-6 flex flex-wrap gap-4"
    >
      {topics.map(topic => <a href={`#${topic.id}`}>{topic.title}</a>)}
    </nav>
    {
      topics.map(topic => (
        <section
          class="border-border my-10 border-t pt-6"
          aria-labelledby={topic.id}
        >
          <h2 id={topic.id} class="text-2xl font-semibold">
            {topic.title}
          </h2>
          <p class="mt-2">{topic.description}</p>
          <ol class="list-decimal ps-6">
            {topic.entries.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ol>
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>
