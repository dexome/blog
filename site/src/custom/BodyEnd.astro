<script>
  import libraryUrl from "../../../themes/congo/assets/lib/mermaid/mermaid.min.js?url";
  import rendererUrl from "../../../preview/congo/assets/js/mermaid.js?url";
  import analyticsUrl from "../../../preview/congo/assets/js/analytics.js?url";
  import { SITE_FEATURES } from "@/astro-paper.config";

  let library: Promise<void> | undefined;
  let previousPage: string | undefined;
  const loadScript = (src: string, data: Record<string, string> = {}) =>
    new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = src;
      script.async = false;
      Object.assign(script.dataset, data);
      script.addEventListener("load", () => resolve(), { once: true });
      script.addEventListener(
        "error",
        () => reject(new Error(`Could not load ${src}`)),
        { once: true }
      );
      document.body.append(script);
    });

  // document.referrer is not updated by client-side navigation.
  document.addEventListener("astro:before-preparation", event => {
    previousPage = event.from.href;
  });

  document.addEventListener("astro:page-load", () => {
    if (
      import.meta.env.MODE === "production" &&
      SITE_FEATURES.analytics &&
      import.meta.env.PUBLIC_DISABLE_ANALYTICS !== "true"
    ) {
      loadScript(analyticsUrl, {
        referrer: previousPage ?? document.referrer,
      }).catch(error => reportError(error));
    }
    if (!document.querySelector(".article-diagram")) return;
    const path = location.pathname;
    library ??= loadScript(libraryUrl);
    library
      .then(async () => {
        if (
          location.pathname === path &&
          document.querySelector(".article-diagram")
        ) {
          await loadScript(rendererUrl);
        }
      })
      .catch(error => {
        library = undefined;
        const detail = error instanceof Error ? error.message : String(error);
        document.querySelectorAll(".article-diagram").forEach(figure => {
          const message = document.createElement("p");
          message.className = "diagram-error";
          message.setAttribute("role", "alert");
          message.textContent = `A diagram could not be displayed (${detail}). Reload the page to try again.`;
          figure.prepend(message);
        });
      });
  });
</script>
