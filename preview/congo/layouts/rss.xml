{{- $pages := .RegularPages.ByDate.Reverse -}}
{{- if .IsHome -}}
  {{- $pages = (where .Site.RegularPages "Section" "post").ByDate.Reverse -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title | htmlEscape }}</title>
    <link>{{ .Permalink | htmlEscape }}</link>
    <description>{{ (.Description | default .Site.Params.description) | htmlEscape }}</description>
    <language>{{ .Site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}
      <atom:link href="{{ .Permalink | htmlEscape }}" rel="self" type="application/rss+xml" />
    {{ end }}
    {{ range first 1 $pages }}
      <lastBuildDate>{{ .Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{ end }}
    {{ range $pages }}
      <item>
        <title>{{ .Title | htmlEscape }}</title>
        <link>{{ .Permalink | htmlEscape }}</link>
        <guid>{{ .Permalink | htmlEscape }}</guid>
        <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <description>{{ .Description | htmlEscape }}</description>
      </item>
    {{ end }}
  </channel>
</rss>
