{{- $index := slice -}}
{{- range where .Site.RegularPages "Section" "post" -}}
  {{- $index = $index | append (dict
    "date" (.Date | time.Format site.Params.dateFormat)
    "title" .Title
    "section" "Writing"
    "summary" .Description
    "content" .Plain
    "permalink" .Permalink
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
